# 复制为 local.env 后填写；local.env 已被 .gitignore 忽略，不会进入提交包。
# DeepSeek 官方 OpenAI 兼容接口：
INTEGRATED_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# 推荐系统 v146（8010）HTTP 登录：不配置则自动降级为离线快照
# 三个演示账号 15547 / 14156 / 17231 共用密码 demo123
# INTEGRATED_DEMO_USER=15547
# INTEGRATED_DEMO_PASSWORD=demo123

# 可选覆盖
# INTEGRATED_ONLINE_LLM_MODEL=deepseek-flash
# INTEGRATED_ONLINE_LLM_TIMEOUT_S=45
# INTEGRATED_ONLINE_LLM_STRICT=0
# DeepSeek Search / Fetch（按成功请求计费）
# INTEGRATED_WEB_SEARCH=1
# INTEGRATED_WEB_SEARCH_COUNT=5
# INTEGRATED_WEB_SEARCH_CONTENT=0
# INTEGRATED_WEB_SEARCH_TIMEOUT_S=30

# 在线识图（阿里云百炼 / Qwen VL，OpenAI 兼容接口）
# DASHSCOPE_API_KEY=
# INTEGRATED_VL_PROVIDER=dashscope
