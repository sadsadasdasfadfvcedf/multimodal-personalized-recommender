{
  "version": "1.0",
  "note": "ASR 识别质量固定测试集。覆盖本项目六类意图与槽位词；参考文本即 TTS 合成文本。must_have 为术语锚点。",
  "cases": [
    {
      "id": "D-01",
      "intent": "discover",
      "text": "推荐一些婚礼用的装饰品",
