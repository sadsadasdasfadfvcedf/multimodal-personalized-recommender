{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "① 调试：一键端到端演示（main.py）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    {
      "name": "② 调试：终端对话（chat.py，可交互输入）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/chat.py",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    {
      "name": "③ 调试：网页对话界面（webui.py）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/webui.py",
      "args": [
        "--no-browser"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    {
      "name": "④ 调试：当前打开的文件",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    {
      "name": "⑤ 调试：阶段1 契约测试",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/01_contract_test.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    {
      "name": "⑥ 调试：阶段3 编排演示",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/03_orchestrator_demo.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    {
      "name": "⑦ 调试：真实模式（main.py --mode auto）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": [
        "--mode",
        "auto",
        "--no-voice"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1",
        "INTEGRATED_ALLOW_REAL_MODELS": "1"
      }
    }
  ]
}
