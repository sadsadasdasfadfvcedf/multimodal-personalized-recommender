# 缓存与字节码
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 语音产物（可再生）
artifacts/
*.wav
*.mp3

# 模型与权重
*.pt
*.pth
*.safetensors
*.bin
*.onnx

# 音视频与图片
*.mp4
*.avi
*.jpg
*.png

# 数据库与压缩包
*.sqlite
*.db
